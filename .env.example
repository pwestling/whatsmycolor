# A pooled Postgres URL from the Vercel Marketplace (Neon recommended).
DATABASE_URL=

# Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Community boards. `convex dev` writes development values to `.env.local`.
CONVEX_URL=
CONVEX_SITE_URL=

# Optional local overrides.
WHATSMYCOLOR_DB_PATH=data/whatsmycolor.db
WHATSMYCOLOR_UPLOAD_PATH=data/uploads
